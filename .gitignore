app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Original source collages stay local; selected runtime preview copies live in assets/.
/Target UI/
/mockup-contact-sheet.jpg
/deliverables/*.apk

